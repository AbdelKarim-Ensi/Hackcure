NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=damm
DB_PASSWORD=change-me
DB_NAME=damm
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
OTP_DEV_MODE=true
# AJOUT : T7.1 générer avec : openssl rand -hex 32 (ne jamais committer la vraie clé ; la perdre rend les formulaires illisibles)
HEALTH_DATA_KEY=remplacer_par_64_caracteres_hex

# T5.2 : délai (en secondes) avant la vague suivante, pour la démo. Absent = délais de production (15 min / 5 min critique).
# WAVE_DELAY_SECONDS=30
QR_TOKEN_SECRET=change-me-long-random-string-32chars
# Démo : rappels J-1 / H-2 envoyés N et 2N secondes après l'inscription (décommenter pour la démo)
REMINDER_DEMO_SECONDS=30
# Démo uniquement : permet de pointer hors du jour de l'événement. Ne jamais activer en déploiement.
# CHECKIN_ALLOW_ANY_DATE=true

# AJOUT : T7.3 limitation de débit (req/min/IP). THROTTLE_DISABLED=true pour mesures de perf et démo
THROTTLE_LIMIT=100
# THROTTLE_DISABLED=true
